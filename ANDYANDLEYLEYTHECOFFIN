local Toggle = MiscTab:CreateToggle({
Name = "ESP",
CurrentValue = false,
Flag = "Toggle1",
Callback = function(Value)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local lp = Players.LocalPlayer

	if not getgenv()._esp then
		getgenv()._esp = {enabled=false, objs={}, conn=nil, render=nil}
	end

	local function createESP(p)
		if p == lp then return end
		if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return end
		if p.Character:FindFirstChild("ESP_HL") then return end

		local color = p.Team and p.Team.TeamColor.Color or Color3.new(1,1,1)

		local hl = Instance.new("Highlight")
		hl.Name = "ESP_HL"
		hl.Adornee = p.Character
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.35
		hl.OutlineTransparency = 0
		hl.FillColor = color
		hl.OutlineColor = color
		hl.Parent = p.Character

		local gui = Instance.new("BillboardGui")
		gui.Name = "ESP_GUI"
		gui.Adornee = p.Character.HumanoidRootPart
		gui.Size = UDim2.fromScale(0, 0)
		gui.AlwaysOnTop = true
		gui.Parent = p.Character

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.fromOffset(200, 40)
		txt.BackgroundTransparency = 1
		txt.TextScaled = false
		txt.TextSize = 12
		txt.Font = Enum.Font.SourceSans
		txt.TextColor3 = color
		txt.TextStrokeTransparency = 0
		txt.Parent = gui

		getgenv()._esp.objs[p] = {hl=hl, txt=txt}
	end

	if Value then
		getgenv()._esp.enabled = true

		for _,p in ipairs(Players:GetPlayers()) do
			createESP(p)
		end

		getgenv()._esp.conn = Players.PlayerAdded:Connect(function(p)
			p.CharacterAdded:Connect(function()
				task.wait(1)
				if getgenv()._esp.enabled then
					createESP(p)
				end
			end)
		end)

		getgenv()._esp.render = RunService.RenderStepped:Connect(function()
			for p,data in pairs(getgenv()._esp.objs) do
				if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local dist = math.floor((lp.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
					data.txt.Text = p.Name .. " [" .. dist .. "]"
				end
			end
		end)

	else
		getgenv()._esp.enabled = false

		if getgenv()._esp.conn then getgenv()._esp.conn:Disconnect() end
		if getgenv()._esp.render then getgenv()._esp.render:Disconnect() end

		for _,data in pairs(getgenv()._esp.objs) do
			if data.hl then data.hl:Destroy() end
			if data.txt then data.txt.Parent:Destroy() end
		end

		getgenv()._esp.objs = {}
	end

end,
})
